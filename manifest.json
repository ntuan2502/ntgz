{
  "manifest_version": 3,
  "name": "Nông Trại GenZ Auto by Tún",
  "version": "1.10.0",
  "description": "Nông Trại GenZ Auto by Tún - Công cụ Auto đa khu vực (DOM + Canvas) thông minh cho game Nông Trại GenZ.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://nongtraigenz.online/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon-192.png",
    "32": "images/icon-192.png",
    "48": "images/icon-192.png",
    "128": "images/icon-192.png",
    "192": "images/icon-192.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nông Trại GenZ Auto by Tún",
    "default_icon": {
      "16": "images/icon-192.png",
      "24": "images/icon-192.png",
      "32": "images/icon-192.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://nongtraigenz.online/play*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js", "tailwind.css", "images/*"],
      "matches": ["https://nongtraigenz.online/*"]
    }
  ],
  "commands": {
    "toggle-auto": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Bật / Tắt Auto"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Ẩn / Hiện bảng điều khiển trên màn hình game"
    }
  }
}
